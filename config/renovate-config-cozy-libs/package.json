{
  "name": "renovate-config-cozy-libs",
  "version": "0.9.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linagora/cozy-libs.git",
    "directory": "config/renovate-config-cozy-libs"
  },
  "description": "Renovate config for Cozy libs",
  "renovate-config": {
    "default": {
      "extends": [
        "cozy"
      ],
      "packageRules": [
        {
          "packagePatterns": [
            "*"
          ],
          "rangeStrategy": "replace"
        },
        {
          "depTypeList": [
            "devDependencies"
          ],
          "rangeStrategy": "pin"
        }
      ]
    }
  },
  "license": "MIT"
}
