@import './base.css'
@import './indicators.css'
@import './bar.css'
@import './banner.css'
@import './nav.css'
@import './navigation_item.css'
@import './apps.css'

@import './theme.styl'
@import './user-menu.styl'
@import './apps-menu.styl'

.coz-bar-skeleton-avatar
  width 2rem
  height 2rem
  border-radius 50%
  background-color rgba(0, 0, 0, 0.12)
  margin 0 0.5rem
  flex-shrink 0
  animation coz-bar-skeleton-pulse 1.2s ease-in-out infinite

.coz-bar-app-icon
  width 32px
  height 32px
  margin 0 4px
  flex-shrink 0

.coz-bar-app-text-icon
  width auto
  height 22px

@keyframes coz-bar-skeleton-pulse
  0%
    opacity 1
  50%
    opacity 0.4
  100%
    opacity 1
