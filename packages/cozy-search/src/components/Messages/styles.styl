.cozyThread-user-messages
  max-width 50%
  width fit-content

  &--light
    background var(--grey100)

  &--dark
    background var(--grey900)

// The 24px "icon animation" of the design: three 3.8px dots, 6.09px apart,
// each rising 2.855px and growing to 115% over 250ms then falling back,
// 150ms after the previous one, on a 1.2s loop.
.thinking-dots
  display flex
  align-items center
  gap 2.28px
  width 24px
  height 24px
  padding-left 4px
  margin-left 8px
  box-sizing border-box

.thinking-dot
  display block
  width 3.8px
  height 3.8px
  border-radius 50%
  background-color #51ACF0
  animation thinking-bounce 1.2s cubic-bezier(0.33, 0, 0.67, 1) infinite

  &:nth-child(2)
    animation-delay 150ms

  &:nth-child(3)
    animation-delay 300ms

@keyframes thinking-bounce
  0%
    transform none
  20.83%
    transform translateY(-2.855px) scale(1.15)
  41.67%
    transform none
  100%
    transform none

@media (prefers-reduced-motion: reduce)
  .thinking-dot
    animation none
