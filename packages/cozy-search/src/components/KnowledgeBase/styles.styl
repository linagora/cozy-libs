.intentHost
    width 100%
    height 70vh

    // cozy-interapp injects a bare <iframe> with no styling of its own
    // (browser default: 150px tall, display inline — the inline baseline
    // gap adds ~4px below, overflowing the dialog into a phantom scrollbar)
    iframe
        display block
        width 100%
        height 100%
        border none

// The hint of the folder chip: the design's tooltip (12px medium, centered,
// on grey A400). Doubled to outweigh the theme's tooltip rule, injected
// after this stylesheet.
.folder-tooltip.folder-tooltip
    max-width 258px
    padding 8px 12px
    border-radius 4px
    background-color var(--greyA400)
    color var(--white)
    font-size 12px
    font-weight 500
    line-height 15.8px
    letter-spacing 0.5px
    text-align center

.folder-tooltip-arrow.folder-tooltip-arrow
    color var(--greyA400)
